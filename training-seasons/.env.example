# Modelo das variáveis de ambiente. Copie para .env.local e preencha.
# NUNCA coloque a chave "service_role" / "secret" aqui. Só as duas abaixo.

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API > chave "anon" / "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site (usado nos links dos e-mails). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
